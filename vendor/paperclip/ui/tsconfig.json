{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@agentself/skins": ["../../../packages/skins/src/index.ts"],
      "@agentself/shared": ["../../../packages/shared/src/index.ts"],
      "@agentself/pixel-office": ["../../../packages/pixel-office/src/index.ts"],
      "lexical": ["./node_modules/lexical/index.d.ts"]
    }
  },
  "include": ["src", "storybook", "vitest.setup.ts"]
}
